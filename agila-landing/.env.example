# Public Cloudflare Turnstile site key used by the browser widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Server-only Cloudflare Turnstile secret used by src/app/api/submit/route.ts.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Optional server-only FormSubmit destination. Defaults to SITE_CONFIG.email.
FORMSUBMIT_EMAIL=contact@example.com

# Runtime settings for the standalone server. Keep it private behind Nginx.
HOSTNAME=127.0.0.1
PORT=3000
